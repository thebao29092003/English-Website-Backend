{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning" // Ẩn các log rác từ framework
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
